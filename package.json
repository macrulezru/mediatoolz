{
  "name": "@macrulez/mediatoolz",
  "version": "0.1.0",
  "description": "A small toolbox of CLI commands for images — resize, convert and recompress them in bulk by rules, and generate hazehash, blurhash and thumbhash placeholders",
  "type": "module",
  "license": "MIT",
  "author": "macrulez <macrulezru@gmail.com> (https://macrulez.ru/en)",
  "homepage": "https://github.com/macrulezru/mediatoolz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macrulezru/mediatoolz.git"
  },
  "bugs": {
    "url": "https://github.com/macrulezru/mediatoolz/issues"
  },
  "keywords": [
    "images",
    "resize",
    "convert",
    "webp",
    "avif",
    "sharp",
    "blurhash",
    "thumbhash",
    "hazehash",
    "placeholder",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "mediatoolz": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config ui/vite.config.ts",
    "dev:ui": "tsx ui/dev.ts",
    "dev:ui:client": "vite --config ui/vite.config.ts",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p ui/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "blurhash": "^2.0.5",
    "commander": "^13.1.0",
    "hazehash": "^0.1.1",
    "ignore": "^6.0.2",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@macrulez/masonry-kit-vue": "^0.1.4",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.8",
    "sass": "^1.105.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.5",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  }
}
